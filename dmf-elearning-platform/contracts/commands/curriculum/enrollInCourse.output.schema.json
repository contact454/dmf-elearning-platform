{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "EnrollInCourseOutput",
    "type": "object",
    "required": [
        "enrollmentId",
        "courseId",
        "status"
    ],
    "properties": {
        "enrollmentId": {
            "type": "string",
            "format": "uuid"
        },
        "courseId": {
            "type": "string"
        },
        "status": {
            "type": "string",
            "enum": [
                "active",
                "completed",
                "dropped"
            ]
        },
        "nextAction": {
            "type": "string",
            "enum": [
                "start_lesson",
                "take_placement"
            ]
        }
    }
}
