{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "UnlockUnitInput",
    "type": "object",
    "required": [
        "userId",
        "unitId",
        "courseId",
        "reason"
    ],
    "properties": {
        "userId": {
            "type": "string",
            "format": "uuid"
        },
        "unitId": {
            "type": "string"
        },
        "courseId": {
            "type": "string"
        },
        "reason": {
            "type": "string",
            "enum": [
                "mastery",
                "assessment",
                "manual",
                "srs"
            ]
        }
    }
}
