{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "RequestFeedbackOutput",
    "type": "object",
    "required": [
        "requestId",
        "submissionId",
        "status"
    ],
    "properties": {
        "requestId": {
            "type": "string",
            "format": "uuid"
        },
        "submissionId": {
            "type": "string",
            "format": "uuid"
        },
        "status": {
            "type": "string",
            "enum": [
                "queued",
                "processing"
            ]
        }
    }
}
