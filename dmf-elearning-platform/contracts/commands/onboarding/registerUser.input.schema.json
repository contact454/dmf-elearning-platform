{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "RegisterUserInput",
    "type": "object",
    "required": [
        "email",
        "role"
    ],
    "properties": {
        "email": {
            "type": "string",
            "format": "email"
        },
        "role": {
            "type": "string",
            "enum": [
                "learner",
                "teacher",
                "mentor",
                "admin"
            ]
        },
        "firstName": {
            "type": "string"
        },
        "lastName": {
            "type": "string"
        },
        "targetLanguage": {
            "type": "string",
            "enum": [
                "de",
                "en",
                "vi"
            ]
        }
    }
}