{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "RegisterUserOutput",
    "type": "object",
    "required": [
        "userId",
        "email",
        "role",
        "createdAt"
    ],
    "properties": {
        "userId": {
            "type": "string",
            "format": "uuid"
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "role": {
            "type": "string",
            "enum": [
                "learner",
                "teacher",
                "mentor",
                "admin"
            ]
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        }
    }
}
