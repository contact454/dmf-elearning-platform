{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SubmitQuizInput",
    "type": "object",
    "required": [
        "assessmentId",
        "answers"
    ],
    "properties": {
        "assessmentId": {
            "type": "string",
            "format": "uuid"
        },
        "attemptId": {
            "type": "string",
            "format": "uuid"
        },
        "answers": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": true
            }
        }
    }
}
