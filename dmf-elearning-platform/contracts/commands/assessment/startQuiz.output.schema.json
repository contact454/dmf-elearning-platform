{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "StartQuizOutput",
    "type": "object",
    "required": [
        "assessmentId",
        "status"
    ],
    "properties": {
        "attemptId": {
            "type": "string",
            "format": "uuid"
        },
        "assessmentId": {
            "type": "string",
            "format": "uuid"
        },
        "status": {
            "type": "string",
            "enum": [
                "scheduled",
                "in-progress",
                "graded"
            ]
        }
    }
}
