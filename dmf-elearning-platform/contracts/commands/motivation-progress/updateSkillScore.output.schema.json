{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "UpdateSkillScoreOutput",
    "type": "object",
    "required": [
        "userId",
        "skill",
        "scoreVal",
        "updatedAt"
    ],
    "properties": {
        "userId": {
            "type": "string",
            "format": "uuid"
        },
        "skill": {
            "type": "string",
            "enum": [
                "vocabulary",
                "grammar",
                "reading",
                "listening",
                "speaking",
                "writing"
            ]
        },
        "scoreVal": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
        },
        "updatedAt": {
            "type": "string",
            "format": "date-time"
        }
    }
}
