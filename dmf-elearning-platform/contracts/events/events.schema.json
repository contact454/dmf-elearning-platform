{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Generic Event",
    "type": "object",
    "required": [
        "event_name",
        "timestamp",
        "user_id",
        "payload"
    ],
    "properties": {
        "event_name": {
            "type": "string",
            "description": "The standardized topic name (e.g. learning.lesson.completed)"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "user_id": {
            "type": "string",
            "format": "uuid"
        },
        "session_id": {
            "type": "string",
            "description": "Optional correlation ID for the user session"
        },
        "context": {
            "type": "object",
            "description": "Metadata (device, ip, version)",
            "additionalProperties": true
        },
        "payload": {
            "type": "object",
            "description": "Event-specific data",
            "additionalProperties": true
        }
    }
}