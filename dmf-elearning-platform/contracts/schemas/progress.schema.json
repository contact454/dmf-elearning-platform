{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Progress",
    "type": "object",
    "description": "ProgressState tracks where the learner is in the curriculum (học tới đâu trong lộ trình). Owned by curriculum-service.",
    "required": [
        "userId",
        "courseId",
        "enrollmentId",
        "unlockedUnitIds",
        "unlockedLessonIds",
        "completedUnitIds",
        "completedLessonIds",
        "lastUpdatedAt",
        "version"
    ],
    "properties": {
        "userId": {
            "type": "string",
            "description": "User ID (ID người học)"
        },
        "courseId": {
            "type": "string",
            "description": "Course ID (ID khóa học)"
        },
        "enrollmentId": {
            "type": "string",
            "description": "Enrollment ID (ID ghi danh)"
        },
        "unlockedUnitIds": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Units available to learner (đơn vị đã mở khóa)"
        },
        "unlockedLessonIds": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Lessons available to learner (bài đã mở khóa)"
        },
        "completedUnitIds": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Units fully completed (đơn vị đã hoàn thành)"
        },
        "completedLessonIds": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Lessons fully completed (bài đã hoàn thành)"
        },
        "currentUnitId": {
            "type": "string",
            "description": "Currently active unit (đơn vị hiện tại)"
        },
        "currentLessonId": {
            "type": "string",
            "description": "Currently active lesson (bài hiện tại)"
        },
        "lastUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of last update (thời gian cập nhật cuối)"
        },
        "version": {
            "type": "number",
            "description": "Version for optimistic locking (phiên bản để khóa lạc quan)"
        }
    }
}
