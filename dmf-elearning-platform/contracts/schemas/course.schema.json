{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Course",
    "type": "object",
    "required": [
        "id",
        "title",
        "level",
        "language"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "title": {
            "type": "string"
        },
        "level": {
            "type": "string",
            "enum": [
                "A1",
                "A2",
                "B1",
                "B2"
            ]
        },
        "language": {
            "type": "string",
            "enum": [
                "de"
            ]
        },
        "unitIds": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}