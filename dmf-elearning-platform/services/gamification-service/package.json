{
  "name": "@dmf/gamification-service",
  "version": "0.1.0",
  "description": "Gamification Service - XP, Levels, Streaks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "TSX_TSCONFIG_PATH=../../tsconfig.json tsx watch src/index.ts",
    "dev:e2e": "TSX_TSCONFIG_PATH=../../tsconfig.json tsx src/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dmf/contracts": "workspace:*",
    "@dmf/infra": "workspace:*",
    "@dmf/ops-metrics": "workspace:*",
    "@dmf/shared": "workspace:*",
    "@prisma/client": "^7.3.0",
    "fastify": "^4.26.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "prisma": "^7.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
