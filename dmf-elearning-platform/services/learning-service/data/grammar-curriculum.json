        {
            "id": "a1-gram-01",
            "level": "A1",
            "order": 1,
            "title": "Artikel: der, die, das",
            "title_vi": "Mạo từ: der, die, das",
            "description": "Genus im Deutschen — Maskulin, Feminin, Neutrum",
            "explanation_vi": "Trong tiếng Đức, mỗi danh từ có giới tính: nam (der), nữ (die), trung (das). Không có quy tắc tuyệt đối, phải học thuộc cùng danh từ.",
            "rules": [
                "Maskulin (der): der Mann, der Tisch, der Apfel",
                "Feminin (die): die Frau, die Lampe, die Blume",
                "Neutrum (das): das Kind, das Buch, das Haus",
                "Plural: immer 'die' — die Männer, die Frauen, die Kinder",
                "Tipp: Berufe auf -er → meist der (der Lehrer, der Fahrer)",
                "Tipp: Wörter auf -ung, -heit, -keit → immer die (die Wohnung, die Freiheit)",
                "Tipp: Wörter auf -chen, -lein → immer das (das Mädchen, das Brötchen)"
            ],
            "examples": [
                {
                    "de": "Der Mann trinkt Kaffee.",
                    "vi": "Người đàn ông uống cà phê."
                },
                {
                    "de": "Die Frau liest ein Buch.",
                    "vi": "Người phụ nữ đọc sách."
                },
                {
                    "de": "Das Kind spielt im Garten.",
                    "vi": "Đứa trẻ chơi trong vườn."
                }
            ],
            "exercises": [
