        {
            "id": "a2-gram-01",
            "level": "A2",
            "order": 1,
            "title": "Perfekt mit haben und sein",
            "title_vi": "Thì hoàn thành với haben và sein",
            "description": "Vergangenheit ausdrücken im Perfekt",
            "explanation_vi": "Perfekt = haben/sein (chia) + Partizip II (cuối câu). Dùng 'sein' cho: động từ chuyển động (gehen, fahren, kommen) và thay đổi trạng thái (werden, sterben). Tất cả còn lại dùng 'haben'.",
            "rules": [
                "haben + Partizip II: Ich habe gegessen. Du hast gelernt.",
                "sein + Partizip II: Ich bin gegangen. Er ist gefahren.",
                "Partizip II (regelmäßig): ge- + Stamm + -t → gemacht, gelernt, gekauft",
                "Partizip II (unregelmäßig): ge- + Stamm + -en → gegessen, getrunken, geschrieben",
                "Trennbare Verben: eingekauft, aufgestanden, mitgebracht",
                "Verben auf -ieren: KEIN ge-! → studiert, telefoniert"
            ],
            "examples": [
                {
                    "de": "Ich habe gestern Deutsch gelernt.",
                    "vi": "Hôm qua tôi đã học tiếng Đức."
                },
                {
                    "de": "Wir sind nach Wien gefahren.",
                    "vi": "Chúng tôi đã đi Vienna."
                },
                {
                    "de": "Sie hat eine E-Mail geschrieben.",
                    "vi": "Cô ấy đã viết một email."
                },
                {
                    "de": "Bist du schon aufgestanden?",
                    "vi": "Bạn đã dậy chưa?"
                }
            ],
            "exercises": [
