        {
            "id": "a1-gram-02",
            "level": "A1",
            "order": 2,
            "title": "Konjugation Präsens — regelmäßige Verben",
            "title_vi": "Chia động từ hiện tại — động từ có quy tắc",
            "description": "Regelmäßige Verben im Präsens konjugieren",
            "explanation_vi": "Chia động từ ở thì hiện tại: bỏ đuôi -en, thêm đuôi mới theo chủ ngữ. ich → -e, du → -st, er/sie/es → -t, wir → -en, ihr → -t, sie/Sie → -en.",
            "rules": [
                "ich lerne, du lernst, er/sie/es lernt",
                "wir lernen, ihr lernt, sie/Sie lernen",
                "Verben auf -t/-d: du arbeitest, er arbeitet (thêm -e-)",
                "Verben auf -s/-ß/-z: du reist (nicht reisst), du tanzt"
            ],
            "examples": [
