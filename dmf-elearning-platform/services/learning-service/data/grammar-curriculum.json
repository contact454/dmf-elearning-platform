        {
            "id": "a1-gram-04",
            "level": "A1",
            "order": 4,
            "title": "Nominativ und Akkusativ",
            "title_vi": "Cách chủ ngữ và cách đối tượng (trực tiếp)",
            "description": "Die ersten zwei Kasus im Deutschen",
            "explanation_vi": "Nominativ = chủ ngữ (ai làm gì?). Akkusativ = tân ngữ trực tiếp (làm cái gì?). Akkusativ CHỈ thay đổi mạo từ nam giới: der → den, ein → einen.",
            "rules": [
                "Nominativ: Der Mann kauft ein Buch. (Der Mann = chủ ngữ)",
                "Akkusativ: Ich sehe den Mann. (den Mann = tân ngữ)",
                "Maskulin: der/ein → den/einen (CHỈ THAY ĐỔI Ở ĐÂY)",
                "Feminin: die/eine → die/eine (không đổi)",
                "Neutrum: das/ein → das/ein (không đổi)",
                "Plural: die → die (không đổi)"
            ],
            "examples": [
                {
                    "de": "Ich kaufe einen Apfel.",
                    "vi": "Tôi mua một quả táo. (einen vì Apfel là maskulin)"
                },
                {
                    "de": "Er trinkt den Kaffee.",
                    "vi": "Anh ấy uống cà phê. (den vì Kaffee là maskulin)"
                },
                {
                    "de": "Ich lese eine Zeitung.",
                    "vi": "Tôi đọc một tờ báo. (eine không đổi vì Zeitung là feminin)"
                },
                {
                    "de": "Wir sehen das Kind.",
                    "vi": "Chúng tôi thấy đứa trẻ. (das không đổi)"
                }
            ],
            "exercises": [
                {
                    "type": "fill_blank",
                    "question": "Ich kaufe ___ Buch. (das)",
                    "answer": "das"
                },
                {
                    "type": "fill_blank",
                    "question": "Sie sieht ___ Mann. (der)",
                    "answer": "den"
                },
                {
                    "type": "fill_blank",
                    "question": "Wir trinken ___ Tee. (der)",
                    "answer": "den"
                },
                {
                    "type": "fill_blank",
                    "question": "Er hat ___ Schwester. (eine)",
                    "answer": "eine"
                },
                {
                    "type": "fill_blank",
                    "question": "Ich brauche ___ Stift. (ein)",
                    "answer": "einen"
                }
            ]
        },
