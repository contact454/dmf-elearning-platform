        {
            "id": "a2-gram-02",
            "level": "A2",
            "order": 2,
            "title": "Dativ und Dativverben",
            "title_vi": "Cách gián tiếp (Dativ) và động từ đi với Dativ",
            "description": "Der dritte Kasus — Dativ",
            "explanation_vi": "Dativ trả lời câu hỏi WEM? (cho ai?). Mạo từ thay đổi: der→dem, die→der, das→dem, die(pl)→den(+n). Một số động từ luôn đi với Dativ: helfen, danken, gefallen, gehören, schmecken.",
            "rules": [
                "Maskulin: der/ein → dem/einem",
                "Feminin: die/eine → der/einer",
                "Neutrum: das/ein → dem/einem",
                "Plural: die → den + Dativ-n (den Kindern, den Frauen)",
                "Dativverben: helfen, danken, gefallen, gehören, schmecken, passen",
                "Dativpräpositionen: mit, bei, nach, zu, von, seit, aus, gegenüber"
            ],
            "examples": [
                {
                    "de": "Ich helfe dem Mann.",
                    "vi": "Tôi giúp người đàn ông."
                },
                {
                    "de": "Das Kleid gefällt der Frau.",
                    "vi": "Cái váy làm người phụ nữ thích."
                },
                {
                    "de": "Ich gebe dem Kind ein Geschenk.",
                    "vi": "Tôi cho đứa trẻ một quà."
                },
                {
                    "de": "Er fährt mit dem Bus.",
                    "vi": "Anh ấy đi bằng xe buýt."
                }
            ],
            "exercises": [
                {
                    "type": "fill_blank",
                    "question": "Ich helfe ___ Lehrerin. (die)",
                    "answer": "der"
                },
                {
                    "type": "fill_blank",
                    "question": "Das Buch gehört ___ Kind. (das)",
                    "answer": "dem"
                },
                {
                    "type": "fill_blank",
                    "question": "Er fährt mit ___ Zug. (der)",
                    "answer": "dem"
                },
                {
                    "type": "fill_blank",
                    "question": "Ich danke ___ Eltern. (die, Plural)",
                    "answer": "den"
                }
            ]
        },
        {
            "id": "b1-gram-01",
            "level": "B1",
            "order": 1,
            "title": "Konjunktiv II — hätte, wäre, würde",
            "title_vi": "Giả định cách II — ước gì, giá mà, sẽ (lịch sự)",
            "description": "Irreale Wünsche und höfliche Bitten",
            "explanation_vi": "Konjunktiv II dùng cho: ước muốn không thực (Wenn ich reich wäre...), lời đề nghị lịch sự (Könnten Sie...), lời khuyên (An deiner Stelle würde ich...). Dạng: würde + Infinitiv, hoặc wäre/hätte/könnte/müsste.",
            "rules": [
                "würde + Infinitiv: Ich würde gern in Berlin wohnen.",
                "wäre (sein): Wenn ich reich wäre, würde ich reisen.",
                "hätte (haben): Wenn ich Zeit hätte, würde ich lesen.",
                "könnte (können): Könnten Sie mir helfen?",
                "Irrealer Wunsch: Ich wünschte, ich wäre in Deutschland.",
                "Höfliche Bitte: Würden Sie bitte das Fenster öffnen?"
            ],
            "examples": [
                {
                    "de": "Wenn ich mehr Geld hätte, würde ich nach Japan fliegen.",
                    "vi": "Nếu tôi có nhiều tiền hơn, tôi sẽ bay đến Nhật."
                },
                {
                    "de": "An deiner Stelle würde ich zum Arzt gehen.",
                    "vi": "Ở vị trí của bạn, tôi sẽ đi bác sĩ."
                },
                {
                    "de": "Könnten Sie mir bitte helfen?",
                    "vi": "Bạn có thể giúp tôi được không?"
                },
                {
                    "de": "Ich wäre gern Musiker.",
                    "vi": "Tôi ước mình là nhạc sĩ."
                }
            ],
            "exercises": [
                {
                    "type": "fill_blank",
                    "question": "Wenn ich reich ___, würde ich um die Welt reisen.",
                    "answer": "wäre"
                },
                {
                    "type": "fill_blank",
                    "question": "Ich ___ gern nach Deutschland fahren.",
                    "answer": "würde"
                },
                {
                    "type": "fill_blank",
                    "question": "Wenn wir mehr Zeit ___, könnten wir ins Kino gehen.",
                    "answer": "hätten"
                },
                {
                    "type": "fill_blank",
                    "question": "___ Sie mir bitte den Weg zeigen?",
                    "answer": "Könnten"
                }
            ]
        },
        {
            "id": "b1-gram-02",
            "level": "B1",
            "order": 2,
            "title": "Relativsätze",
            "title_vi": "Mệnh đề quan hệ",
            "description": "Personen und Dinge genauer beschreiben",
