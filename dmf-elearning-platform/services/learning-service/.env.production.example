# Learning Service - Production Environment Template

NODE_ENV=production
PORT=3003

# PostgreSQL (managed DB in production)
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>?schema=public"

# Supabase JWT verification
SUPABASE_JWT_SECRET="<supabase-jwt-secret>"

# Optional fallback if you cannot provide SUPABASE_JWT_SECRET
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<supabase-anon-key>"

# Enforce strict subject matching for user-bound resources
AUTH_ENFORCE_SUBJECT_MATCH=true

# Must remain false in production
AUTH_ALLOW_UNVERIFIED_JWT=false

# API rate limiting (baseline)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=240
RATE_LIMIT_REVIEW_WINDOW_MS=60000
RATE_LIMIT_REVIEW_MAX_REQUESTS=120
RATE_LIMIT_AUDIO_WINDOW_MS=60000
RATE_LIMIT_AUDIO_MAX_REQUESTS=60

# Lightweight runtime monitoring alerts
MONITORING_ALERTS_ENABLED=true
MONITORING_WINDOW_MS=60000
MONITORING_5XX_ALERT_THRESHOLD=5
MONITORING_429_ALERT_THRESHOLD=10
MONITORING_SLOW_REQUEST_MS=1500
MONITORING_LOG_ALL_REQUESTS=false

# Optional Claude API
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL=""
