{
  "name": "learning-service",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec 'ts-node --transpile-only' src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma",
    "seed": "tsx prisma/seed-vocabulary-a1b1.ts",
    "seed:vocabulary:a1b1": "tsx prisma/seed-vocabulary-a1b1.ts",
    "seed:content:phase2": "tsx prisma/seed-phase2-content.ts",
    "smoke:phase3": "tsx scripts/phase3-core-loop-smoke.ts",
    "smoke:phase3:feedback": "tsx scripts/phase3-feedback-hub-smoke.ts",
    "seed:vocabulary": "tsx prisma/seed-vocabulary.ts",
    "repair-vocab": "tsx scripts/repair-vocab.ts",
    "data:mine": "node scripts/mining-drill.mjs",
    "data:seed": "npx tsx prisma/seed-vocabulary-a1b1.ts",
    "data:repair": "npx tsx scripts/repair-vocab.ts",
    "data:pipeline": "npm run data:mine && npm run data:seed && npm run data:repair"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "npx tsx prisma/seed-vocabulary-a1b1.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@prisma/client": "^6.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "node-cache": "^5.1.2",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "@google-cloud/text-to-speech": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.1.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.2.0",
    "nodemon": "^3.1.11",
    "prisma": "^6.2.0",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^1.2.0"
  }
}
