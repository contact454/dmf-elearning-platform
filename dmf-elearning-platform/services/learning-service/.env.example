# Learning Service - Environment Variables

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dmf_learning_db?schema=public"

# Service Port
PORT=3003

# Environment
NODE_ENV=development

# Optional Claude API Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL=""

# ----------------------------------------------------------------------
# Auth / JWT verification (required for protected routes in production)
# ----------------------------------------------------------------------

# Preferred: local JWT signature verification for Supabase access tokens
SUPABASE_JWT_SECRET=""

# Fallback verification path (if JWT secret is not available)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Security hardening
AUTH_ENFORCE_SUBJECT_MATCH=true
AUTH_ALLOW_UNVERIFIED_JWT=false

# ----------------------------------------------------------------------
# API rate limiting (Phase 6 bootstrap)
# ----------------------------------------------------------------------

# Set to false to disable all app-level rate limiting (not recommended)
RATE_LIMIT_ENABLED=true

# Rate limit backend store: "memory" (default) or "redis" (distributed, recommended for production)
RATE_LIMIT_STORE=memory

# Redis connection URL (required when RATE_LIMIT_STORE=redis)
REDIS_URL=redis://localhost:6379

# Global API limiter (/api/*)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=240

# Review endpoints limiter (/api/review/*)
RATE_LIMIT_REVIEW_WINDOW_MS=60000
RATE_LIMIT_REVIEW_MAX_REQUESTS=120

# Audio endpoints limiter (/api/audio/*)
RATE_LIMIT_AUDIO_WINDOW_MS=60000
RATE_LIMIT_AUDIO_MAX_REQUESTS=60

# ----------------------------------------------------------------------
# Security headers (OWASP baseline)
# ----------------------------------------------------------------------

# Set to false to disable OWASP security headers
SECURITY_HEADERS_ENABLED=true

# Comma-separated CORS allowed origins (overrides default '*')
# CORS_ALLOWED_ORIGINS=https://dmf-elearning.vercel.app,http://localhost:3000

# Custom Content-Security-Policy (override automatic policy)
# CONTENT_SECURITY_POLICY="default-src 'self'"

# ----------------------------------------------------------------------
# TTS provider (Phase 4 hardening)
# ----------------------------------------------------------------------

# Server-side TTS toggle
TTS_SERVER_ENABLED=true

# Supported values: google | none
TTS_PROVIDER=google

# Optional synthesis defaults
TTS_DEFAULT_LANGUAGE=de-DE
TTS_GOOGLE_VOICE_NAME=de-DE-Wavenet-D
TTS_SPEAKING_RATE=0.9
TTS_PITCH=0

# Google TTS provider credentials
# Use ONE of these options:
# 1) API key (recommended for this service setup)
GOOGLE_TTS_API_KEY=""
# 2) Inline service account JSON (optional alternative)
GOOGLE_TTS_CREDENTIALS_JSON=""
# 3) Service account key file path (optional alternative)
GOOGLE_APPLICATION_CREDENTIALS=""

# ----------------------------------------------------------------------
# Lightweight monitoring alerts (Phase 6)
# ----------------------------------------------------------------------

# Request logging middleware (Phase 6)
# Set to false to disable request log lines.
REQUEST_LOGGING_ENABLED=true

# Set to true to include query string in logged path.
REQUEST_LOG_INCLUDE_QUERY=false

# Service label used in request log lines.
REQUEST_LOG_SERVICE_NAME=learning-service

# Set to false to disable runtime monitoring alerts
MONITORING_ALERTS_ENABLED=true

# Alert window in milliseconds
MONITORING_WINDOW_MS=60000

# Emit alert when 5xx count in window reaches threshold
MONITORING_5XX_ALERT_THRESHOLD=5

# Emit alert when 429 count in window reaches threshold
MONITORING_429_ALERT_THRESHOLD=10

# Emit alert when combined 401/403 count in window reaches threshold
MONITORING_AUTH_ALERT_THRESHOLD=25

# Log warning when a single request exceeds this duration
MONITORING_SLOW_REQUEST_MS=1500

# Set to true to log all requests (method/path/status/duration)
MONITORING_LOG_ALL_REQUESTS=false
