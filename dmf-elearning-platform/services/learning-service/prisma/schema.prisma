generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vocabulary {
  id          String   @id @default(uuid())
  word        String   @unique
  meaning_vi  String
  level       String   // A1, A2, B1...
  topic       String?
  example_de  String?
  example_vi  String?
  pos         String?  // noun, verb, adj
  artikel     String?  // der, die, das (for nouns)
  plural      String?  // plural form: Äpfel, Häuser
  gender      String?  // m, f, n (masculine, feminine, neuter)
  audioUrl    String?  // TTS audio URL
  phoneticIpa String?  // IPA pronunciation
  familyWords String[] // Related words from same root
  grammarTags String[] // Grammar categories
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  progress    UserVocabularyProgress[]
}

model UserVocabularyProgress {
  id             String     @id @default(uuid())
  userId         String
  vocabId        String
  vocabulary     Vocabulary @relation(fields: [vocabId], references: [id])

  // Status
  status         String     @default("new") // new, learning, review, mastered

  // SM-2 Algorithm Fields
  easeFactor     Float      @default(2.5)   // SM-2 ease factor (min 1.3)
  interval       Int        @default(0)     // Days until next review
  repetitions    Int        @default(0)     // Consecutive correct answers
  nextReviewAt   DateTime?                  // Scheduled review date
  lastReviewedAt DateTime?                  // Last review timestamp

  // Statistics
  totalReviews   Int        @default(0)     // Total review count
  correctReviews Int        @default(0)     // Correct answer count
  lapseCount     Int        @default(0)     // Times marked as "Again"

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([userId, vocabId])
  @@index([userId, status])
  @@index([userId, nextReviewAt])
}
