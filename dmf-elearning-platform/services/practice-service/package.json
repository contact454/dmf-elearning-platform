{
  "name": "@dmf/practice-service",
  "version": "0.1.0",
  "description": "Practice service for DMF E-Learning Platform",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "TSX_TSCONFIG_PATH=../../tsconfig.json tsx watch src/index.ts",
    "dev:e2e": "TSX_TSCONFIG_PATH=../../tsconfig.json tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dmf/shared": "workspace:*",
    "@dmf/contracts": "workspace:*",
    "@dmf/infra": "workspace:*",
    "@dmf/ops-metrics": "workspace:*",
    "fastify": "^4.24.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
