{
  "name": "@dmf/infra",
  "version": "0.1.0",
  "description": "Infrastructure interfaces for DMF E-Learning Platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dmf/contracts": "workspace:*",
    "@dmf/ops": "workspace:*",
    "@dmf/evidence": "workspace:*",
    "@dmf/read-models": "workspace:*",
    "better-sqlite3": "^9.2.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
