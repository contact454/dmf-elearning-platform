{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "User",
    "type": "object",
    "required": [
        "id",
        "email",
        "role"
    ],
    "properties": {
        "id": {
            "type": "string",
            "format": "uuid"
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "role": {
            "type": "string",
            "enum": [
                "learner",
                "teacher",
                "mentor",
                "admin"
            ]
        },
        "firstName": {
            "type": "string"
        },
        "lastName": {
            "type": "string"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        }
    }
}