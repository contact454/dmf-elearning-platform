{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Learner Profile",
    "type": "object",
    "required": [
        "userId",
        "targetLanguage",
        "cefrLevel"
    ],
    "properties": {
        "userId": {
            "type": "string",
            "format": "uuid"
        },
        "targetLanguage": {
            "type": "string",
            "example": "de"
        },
        "cefrLevel": {
            "type": "string",
            "enum": [
                "A1",
                "A2",
                "B1",
                "B2",
                "C1",
                "C2"
            ]
        },
        "goals": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}