{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Rubric Score",
    "type": "object",
    "required": [
        "criteria",
        "score",
        "maxScore"
    ],
    "properties": {
        "criteria": {
            "type": "string",
            "description": "e.g., Logical Flow, Pronunciation"
        },
        "score": {
            "type": "number"
        },
        "maxScore": {
            "type": "number"
        },
        "comment": {
            "type": "string"
        }
    }
}