{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Readiness",
    "type": "object",
    "required": [
        "userId",
        "currentLevel",
        "isReadyForNext"
    ],
    "properties": {
        "userId": {
            "type": "string",
            "format": "uuid"
        },
        "currentLevel": {
            "type": "string"
        },
        "isReadyForNext": {
            "type": "boolean"
        },
        "blockers": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "List of weak skills blocking progress"
        }
    }
}