{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Lesson",
    "type": "object",
    "required": [
        "id",
        "title",
        "type"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "unitId": {
            "type": "string"
        },
        "title": {
            "type": "string"
        },
        "type": {
            "type": "string",
            "enum": [
                "lecture",
                "practice",
                "quiz"
            ]
        },
        "contentReference": {
            "type": "string",
            "description": "Path to content file"
        }
    }
}