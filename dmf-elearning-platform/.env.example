# ═══════════════════════════════════════════════════════════
# DMF eLearning Platform — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# See also service-specific .env.example files:
#   - apps/web-learner/.env.example
#   - services/learning-service/.env.example

# ─── General ───
NODE_ENV=development

# ─── Database (PostgreSQL) ───
# REQUIRED: No default value — must be explicitly set
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ─── Redis ───
# REQUIRED: No default value — must be explicitly set
REDIS_PASSWORD=your_secure_redis_password_here

# ─── Supabase ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ─── AI / Anthropic ───
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Grafana ───
GRAFANA_PASSWORD=your_secure_grafana_password_here

# ─── CORS (comma-separated list of allowed origins, used by all services) ───
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dmf-elearning.vercel.app

# ─── CSRF Protection ───
# CSRF_HEADER_NAME=x-requested-with
# CSRF_HEADER_VALUE=
# CSRF_EXEMPT_PATHS=

# ─── Kubernetes Deployment (used by setup-cluster.sh) ───
# DATABASE_URL=postgresql://user:password@host:5432/dmf_learning
# REDIS_URL=redis://:password@host:6379
